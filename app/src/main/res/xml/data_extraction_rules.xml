<?xml version="1.0" encoding="utf-8"?>
<!--
  Applies from API 31. See backup_rules.xml for why these are excluded from both
  cloud backup and direct device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="lumen.db" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="lumen.db" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
