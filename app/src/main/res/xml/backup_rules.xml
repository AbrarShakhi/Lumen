<?xml version="1.0" encoding="utf-8"?>
<!--
  Applies below API 31. The Room database and DataStore files are excluded: the index
  is cheap to rebuild on a new device, and secrets.json holds AES-GCM ciphertext bound
  to an AndroidKeyStore key that is never backed up, so restored bytes are undecryptable.
-->
<full-backup-content>
    <exclude domain="database" path="lumen.db" />
    <exclude domain="file" path="datastore/" />
</full-backup-content>
